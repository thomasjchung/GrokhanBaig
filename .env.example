# Professional account that performs Business Discovery lookups.
# Instagram Login tokens are not enough. Use a Facebook Login token.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# Optional. Caption parsing runs without it. Set it to let Grok read captions.
XAI_API_KEY=

# Google sign-in. Redirect URI must be http://127.0.0.1:5174/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5174/api/google/callback
FRONTEND_ORIGIN=http://127.0.0.1:5174
